# Your data: listening database, Spotify tokens, settings, logs. Never commit.
data/

# Safety nets in case private files end up outside data/
*.db
*.db-wal
*.db-shm
tokens.json
.env
*.key

# Python
backend/.venv/
.venv/
__pycache__/
*.pyc

# PyInstaller output (the logger exe is built, not committed)
build/
dist/
*.spec

# Node / Vite
node_modules/
app/dist/

# Tauri / Rust
app/src-tauri/target/
app/src-tauri/gen/
app/src-tauri/binaries/

# Editors and OS
.vscode/
.idea/
*.log
Thumbs.db
.DS_Store

# Release files to upload to GitHub (built, not committed)
release/
